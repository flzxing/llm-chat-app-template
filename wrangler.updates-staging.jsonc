{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "lucky-updates-staging", "main": "src/app-updates-entry.ts", "compatibility_date": "2025-10-08",
 "compatibility_flags": ["nodejs_compat"], "workers_dev": true,
 "assets": { "binding": "ASSETS", "directory": "./public", "run_worker_first": ["/v1/app-updates/*", "/v1/admin/app-updates/*", "/v1/internal/app-updates/*", "/assets/app-releases/*", "/assets/app-update-art/*", "/download/*"] },
 "vars": { "UPDATE_PACKAGE_NAME": "com.flzxing.lucky.updateqa" },
 "d1_databases": [{ "binding": "DB", "database_name": "lucky-updates-staging", "database_id": "effd0d59-593a-41f5-a850-c1feb1443dd8" }],
 "r2_buckets": [{ "binding": "APP_RELEASES", "bucket_name": "lucky-app-releases-staging" }],
 "queues": { "producers": [{ "binding": "UPDATE_VERIFY_QUEUE", "queue": "lucky-apk-verification-staging" }] },
 "triggers": { "crons": ["*/5 * * * *"] }, "observability": { "enabled": true }
}
