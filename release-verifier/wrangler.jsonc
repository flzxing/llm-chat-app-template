{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "lucky-apk-verifier", "main": "src/index.ts", "compatibility_date": "2026-10-01",
 "containers": [{ "class_name": "ApkVerifier", "image": "./Dockerfile", "max_instances": 2, "instance_type": "basic" }],
 "durable_objects": { "bindings": [{ "name": "APK_VERIFIER", "class_name": "ApkVerifier" }] },
 "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApkVerifier"] }],
 "queues": { "consumers": [{ "queue": "lucky-apk-verification", "max_batch_size": 1, "max_retries": 3, "dead_letter_queue": "lucky-apk-verification-failed", "max_concurrency": 2 }] },
 "r2_buckets": [{ "binding": "APP_RELEASES", "bucket_name": "lucky-app-releases" }],
 "services": [{ "binding": "RELEASE_API", "service": "llm-chat-app-template" }],
 "observability": { "enabled": true }
}
